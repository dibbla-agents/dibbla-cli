# The Dibbla CLI as a CI image — the opt-in distroless variant, tagged
# `X.Y.Z-distroless`.
#
# Identical to the default image (see Dockerfile) except for the base: no shell,
# no package manager, nothing but the CLI and CA certificates.
#
# ⚠️ Reach for this only when a step is a SINGLE CLI invocation. Without a shell,
# a runner cannot generate a script, so Woodpecker's `commands:` — and the
# equivalent in GitLab CI and most other runners — cannot start at all:
#
#     exec: "/bin/sh": stat /bin/sh: no such file or directory
#
# In Woodpecker that means an `entrypoint:` step with the full argv and no
# `commands:` key:
#
#     steps:
#       deploy:
#         image: ghcr.io/dibbla-agents/dibbla-cli:1.2.63-distroless
#         entrypoint: [/usr/local/bin/dibbla, deploy, ., --update]
#
# The trade is explicit: you give up loops, pipes and any logic between CLI
# calls, and you get a smaller image with no scripting surface. If a pipeline
# needs to poll, grep or branch, use the default image instead — that is the
# whole reason it is the default (DIB-418).
#
# Refresh with:  crane digest gcr.io/distroless/static-debian12:latest
FROM gcr.io/distroless/static-debian12:latest@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2

ARG TARGETARCH
ARG VERSION

LABEL org.opencontainers.image.title="dibbla" \
      org.opencontainers.image.description="Dibbla CLI — deploy and manage Dibbla applications from CI (distroless, no shell)" \
      org.opencontainers.image.source="https://github.com/dibbla-agents/dibbla-cli" \
      org.opencontainers.image.url="https://dibbla.com" \
      org.opencontainers.image.vendor="Dibbla Agents" \
      org.opencontainers.image.version="${VERSION}"

COPY stage/linux_${TARGETARCH}/dibbla /usr/local/bin/dibbla

ENV DIBBLA_IN_CONTAINER=1

ENTRYPOINT ["/usr/local/bin/dibbla"]
