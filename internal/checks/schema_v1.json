{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dibbla.com/application-checks/v1.json",
  "title": "Dibbla Application Checks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checks"],
  "properties": {
    "version": { "const": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "schedule": { "type": "string", "enum": ["nightly"] },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h)$",
      "maxLength": 16
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/"
    },
    "route": { "$ref": "#/$defs/id" },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "literal": { "type": "string", "maxLength": 4096 },
        "secret_ref": { "$ref": "#/$defs/id" }
      },
      "oneOf": [
        { "required": ["literal"] },
        { "required": ["secret_ref"] }
      ]
    },
    "headers": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z0-9-]{1,64}$" },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "route", "path"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "HEAD", "OPTIONS"] },
        "route": { "$ref": "#/$defs/route" },
        "path": { "$ref": "#/$defs/path" },
        "headers": { "$ref": "#/$defs/headers" },
        "timeout": { "$ref": "#/$defs/duration" },
        "max_redirects": { "type": "integer", "minimum": 0, "maximum": 5 },
        "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "body_contains": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "json_has": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "httpStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "expect"],
      "properties": {
        "request": { "$ref": "#/$defs/request" },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "navigate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "path"],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "path": { "$ref": "#/$defs/path" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control"],
      "properties": {
        "control": { "$ref": "#/$defs/id" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "value"],
      "properties": {
        "control": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/value" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "assertText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "control": { "$ref": "#/$defs/id" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "browserStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigate": { "$ref": "#/$defs/navigate" },
        "click": { "$ref": "#/$defs/control" },
        "fill": { "$ref": "#/$defs/fill" },
        "assert_text": { "$ref": "#/$defs/assertText" }
      },
      "oneOf": [
        { "required": ["navigate"] },
        { "required": ["click"] },
        { "required": ["fill"] },
        { "required": ["assert_text"] }
      ]
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric", "output"],
      "properties": {
        "rubric": { "type": "string", "minLength": 1, "maxLength": 512 },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "reason"],
          "properties": {
            "pass": { "const": "boolean" },
            "reason": { "const": "string" }
          }
        }
      }
    },
    "httpCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "kind", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "kind": { "const": "http_sequence" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "failure_threshold": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cooldown": { "$ref": "#/$defs/duration" },
        "run_deadline": { "$ref": "#/$defs/duration" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/httpStep" } }
      }
    },
    "browserCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "kind", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "kind": { "const": "browser_journey" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "failure_threshold": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cooldown": { "$ref": "#/$defs/duration" },
        "run_deadline": { "$ref": "#/$defs/duration" },
        "identity_grant": { "$ref": "#/$defs/id" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/browserStep" } }
      }
    },
    "semanticCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "kind", "request", "deterministic_expect", "judge"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "kind": { "const": "semantic" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "failure_threshold": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cooldown": { "$ref": "#/$defs/duration" },
        "run_deadline": { "$ref": "#/$defs/duration" },
        "request": { "$ref": "#/$defs/request" },
        "deterministic_expect": { "$ref": "#/$defs/expect" },
        "judge": { "$ref": "#/$defs/judge" }
      }
    },
    "compositeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "kind", "checks", "reducer"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "kind": { "const": "composite" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "failure_threshold": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cooldown": { "$ref": "#/$defs/duration" },
        "run_deadline": { "$ref": "#/$defs/duration" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "reducer": { "const": "all_required" }
      }
    },
    "check": {
      "oneOf": [
        { "$ref": "#/$defs/httpCheck" },
        { "$ref": "#/$defs/browserCheck" },
        { "$ref": "#/$defs/semanticCheck" },
        { "$ref": "#/$defs/compositeCheck" }
      ]
    }
  }
}
